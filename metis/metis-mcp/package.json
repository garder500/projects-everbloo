{
  "name": "metis-mcp",
  "version": "0.1.0",
  "description": "Serveur MCP pour l'exploration globale de code multi-dépôts dans le projet Metis",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "build": "bun build --compile ./src/index.ts --outfile dist/metis-mcp.exe",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 ./src/index.ts --outfile dist/metis-mcp-windows-x64.exe",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile dist/metis-mcp-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 ./src/index.ts --outfile dist/metis-mcp-linux-arm64",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 ./src/index.ts --outfile dist/metis-mcp-darwin-x64",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/index.ts --outfile dist/metis-mcp-darwin-arm64",
    "build:all": "bun run build:windows-x64 && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-exploration",
    "metis",
    "multi-repo"
  ],
  "author": "Metis Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
